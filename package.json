{
  "name": "uc4-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "lint": "eslint .",
    "docs": "uv run zensical serve",
    "docs:build": "uv run zensical build",
    "docs:shots": "node tools/guide-shots/run.ts",
    "pages": "npm run build && npm run docs:build && node tools/pages.ts",
    "pages:preview": "vite preview --base /UC4_Editor/"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
